FROM docker.m.daocloud.io/library/node:22-alpine AS builder

WORKDIR /build
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-audit --no-fund
COPY . .

ARG ZHIXU_BUILD_ID
ARG ZHIXU_GIT_COMMIT
ARG ZHIXU_BUILD_TIME
ARG NEXT_PUBLIC_ZHIXU_MASTER_SETTINGS_AUTHORITY=browser
ARG NEXT_PUBLIC_ZHIXU_QUOTE_WRITER_MODE=writable
ARG NEXT_PUBLIC_ZHIXU_QUOTE_AUTHORITY=browser
ARG ZHIXU_IDENTITY_MODE=session
RUN case "$NEXT_PUBLIC_ZHIXU_MASTER_SETTINGS_AUTHORITY" in browser|frozen|server) ;; *) echo 'invalid_master_settings_authority_build_input' >&2; exit 1 ;; esac
RUN case "$ZHIXU_IDENTITY_MODE" in session|local-single-user) ;; *) echo 'invalid_identity_mode_build_input' >&2; exit 1 ;; esac
RUN case "$NEXT_PUBLIC_ZHIXU_QUOTE_WRITER_MODE" in writable|frozen) ;; *) echo 'invalid_quote_writer_mode' >&2; exit 1 ;; esac
ENV ZHIXU_BUILD_ENV=production \
    ZHIXU_BUILD_ID=${ZHIXU_BUILD_ID} \
    ZHIXU_GIT_COMMIT=${ZHIXU_GIT_COMMIT} \
    ZHIXU_BUILD_TIME=${ZHIXU_BUILD_TIME} \
    NEXT_PUBLIC_ZHIXU_MASTER_SETTINGS_AUTHORITY=${NEXT_PUBLIC_ZHIXU_MASTER_SETTINGS_AUTHORITY} \
    NEXT_PUBLIC_ZHIXU_IDENTITY_MODE=${ZHIXU_IDENTITY_MODE} \
    NEXT_PUBLIC_ZHIXU_QUOTE_WRITER_MODE=${NEXT_PUBLIC_ZHIXU_QUOTE_WRITER_MODE} \
    NEXT_PUBLIC_ZHIXU_QUOTE_AUTHORITY=${NEXT_PUBLIC_ZHIXU_QUOTE_AUTHORITY} \
    ZHIXU_IDENTITY_MODE=${ZHIXU_IDENTITY_MODE}
RUN npm run build && npm run server:build && node scripts/build-q3-import-runners.mjs

FROM docker.m.daocloud.io/library/node:22-alpine

ARG ZHIXU_BUILD_ID
ARG ZHIXU_GIT_COMMIT
ARG ZHIXU_BUILD_TIME
ARG NEXT_PUBLIC_ZHIXU_MASTER_SETTINGS_AUTHORITY=browser
ARG NEXT_PUBLIC_ZHIXU_QUOTE_WRITER_MODE=writable
ARG NEXT_PUBLIC_ZHIXU_QUOTE_AUTHORITY=browser
ARG ZHIXU_IDENTITY_MODE=session
ENV NODE_ENV=production \
    ZHIXU_BUILD_ENV=production \
    ZHIXU_BUILD_ID=${ZHIXU_BUILD_ID} \
    ZHIXU_GIT_COMMIT=${ZHIXU_GIT_COMMIT} \
    ZHIXU_BUILD_TIME=${ZHIXU_BUILD_TIME} \
    NEXT_PUBLIC_ZHIXU_MASTER_SETTINGS_AUTHORITY=${NEXT_PUBLIC_ZHIXU_MASTER_SETTINGS_AUTHORITY} \
    NEXT_PUBLIC_ZHIXU_QUOTE_WRITER_MODE=${NEXT_PUBLIC_ZHIXU_QUOTE_WRITER_MODE} \
    NEXT_PUBLIC_ZHIXU_QUOTE_AUTHORITY=${NEXT_PUBLIC_ZHIXU_QUOTE_AUTHORITY} \
    ZHIXU_IDENTITY_MODE=${ZHIXU_IDENTITY_MODE}
LABEL io.zhixu.build-id=${ZHIXU_BUILD_ID} \
      io.zhixu.quote-authority=${NEXT_PUBLIC_ZHIXU_QUOTE_AUTHORITY} \
      io.zhixu.quote-writer-mode=${NEXT_PUBLIC_ZHIXU_QUOTE_WRITER_MODE} \
      io.zhixu.master-settings-authority=${NEXT_PUBLIC_ZHIXU_MASTER_SETTINGS_AUTHORITY} \
      io.zhixu.identity-mode=${ZHIXU_IDENTITY_MODE} \
      org.opencontainers.image.revision=${ZHIXU_GIT_COMMIT} \
      org.opencontainers.image.created=${ZHIXU_BUILD_TIME}

WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --from=builder /build/dist/client ./dist/client/
COPY --from=builder /build/dist/server ./dist/server/
COPY database/migrations ./database/migrations/
COPY templates/quote-export-template-v1.xlsx ./templates/quote-export-template-v1.xlsx

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=8s --start-period=8s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/v1/health | grep -q '"status":"ok"' || exit 1

CMD ["node", "dist/server/server/index.js"]
