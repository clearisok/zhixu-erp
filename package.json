{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:local": "vinext dev --hostname 127.0.0.1 --port 3001",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node dist/server/server/index.js",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:status": "tsx server/db/migration-status.ts",
    "test:bootstrap-source": "tsx --test --test-concurrency=1 server/integration/bootstrap-source.test.ts",
    "test:bootstrap-runner": "tsx --test --test-concurrency=1 server/integration/bootstrap-source.test.ts server/integration/bootstrap-runner.integration.test.ts",
    "test:rbac-activation": "tsx --test --test-concurrency=1 server/integration/rbac-activation.integration.test.ts",
    "test:server-auth-frontend": "tsx --test features/server-auth/__tests__/*.test.ts features/quote-center/server/__tests__/*.test.ts",
    "test:server-auth-integration": "tsx --test --test-concurrency=1 server/integration/browser-session-e2e.integration.test.ts",
    "test:shadow-read": "node --test tests/sales-order-server-shadow-read.test.mjs",
    "test:fresh-start": "tsx --test --test-concurrency=1 server/integration/fresh-start.integration.test.ts",
    "test:quote-server-ui": "tsx --test --test-concurrency=1 server/integration/quote-server-ui.integration.test.mjs",
    "test:quote-creation": "tsx --test --test-concurrency=1 features/quote-center/server/__tests__/quote-creation-contract.test.ts server/integration/quote-creation.integration.test.ts",
    "test:quote-version-workflows": "tsx --test --test-concurrency=1 server/integration/quote-version-workflows.integration.test.ts",
    "test:estimate-workflows": "tsx --test --test-concurrency=1 server/integration/estimate-workflows.integration.test.ts",
    "test:database-ops": "node --test scripts/__tests__/database-ops-safety.test.mjs && tsx --test server/db/migration-evidence.test.ts",
    "preview:quote-master-settings": "tsx scripts/preview-quote-master-settings-backup.ts",
    "rehearse:quote-master-settings": "tsx scripts/rehearse-quote-master-settings.ts",
    "preview:quote-history": "tsx scripts/preview-quote-history-backup.ts",
    "rehearse:quote-history": "tsx scripts/rehearse-quote-history-backup.ts",
    "test:confirmed-commercial-terms": "tsx --test --test-concurrency=1 features/confirmed-commercial-terms/__tests__/client.test.ts server/integration/confirmed-commercial-terms.integration.test.ts && node --test tests/confirmed-commercial-terms-ui.test.mjs",
    "demo:delivery-plans": "tsx scripts/demo-delivery-plans.ts",
    "test:delivery-plans": "tsx --test --test-concurrency=1 server/integration/delivery-plans.integration.test.ts",
    "test:postgres": "tsx --test --test-concurrency=1 server/integration/postgres.integration.test.ts server/integration/migration-activation.integration.test.ts server/integration/confirmed-commercial-terms.integration.test.ts server/integration/bootstrap-runner.integration.test.ts server/integration/rbac-activation.integration.test.ts server/integration/browser-session-e2e.integration.test.ts server/integration/quote-foundation.integration.test.ts server/integration/quote-api.integration.test.ts server/integration/quote-numbering.integration.test.ts server/integration/quote-creation.integration.test.ts server/integration/quote-master-settings.integration.test.ts server/integration/quote-master-settings-migration.integration.test.ts server/integration/local-single-user.integration.test.ts server/integration/quote-attachments.integration.test.ts server/integration/s3-storage.integration.test.ts server/integration/quote-history.integration.test.ts server/integration/quote-guarded-import.integration.test.ts server/integration/quote-version-workflows.integration.test.ts server/integration/estimate-workflows.integration.test.ts server/integration/delivery-plans.integration.test.ts server/integration/commercial-rbac.integration.test.ts server/integration/commercial-terms-security.integration.test.ts server/integration/commercial-read-surfaces.integration.test.ts server/integration/commercial-amount-exposure-audit.integration.test.ts server/integration/quote-cost-security.integration.test.ts server/integration/linked-commercial-terms.integration.test.ts server/integration/internal-summary.integration.test.ts server/integration/quote-export.integration.test.ts server/integration/quote-confirmation.integration.test.ts server/integration/quote-batch-export.integration.test.ts",
    "test:quote-history": "tsx --test --test-concurrency=1 server/integration/quote-history.integration.test.ts",
    "test:quote-guarded-import": "tsx --test --test-concurrency=1 server/integration/quote-guarded-import.integration.test.ts",
    "test:attachment-s3": "tsx --test --test-concurrency=1 server/integration/s3-storage.integration.test.ts",
    "preflight:object-storage": "tsx scripts/preflight-object-storage.ts",
    "check:object-storage-config": "tsx scripts/check-object-storage-config.ts",
    "build:object-storage-tools": "npm run server:build && node scripts/build-object-storage-tools.mjs",
    "setup:object-storage-credentials": "node scripts/setup-object-storage-credentials.mjs",
    "test:object-storage-credentials": "tsx --test --test-concurrency=1 server/integration/object-storage-credentials.test.ts",
    "test:object-storage-preflight": "tsx --test --test-concurrency=1 server/integration/object-storage-preflight.integration.test.ts",
    "qa:data:prepare": "node scripts/generate-ui-qa-data.mjs prepare",
    "qa:data:cleanup": "node scripts/generate-ui-qa-data.mjs cleanup",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test tests/*.test.mjs",
    "check:release-baseline": "node scripts/check-release-baseline.mjs",
    "test:release-baseline": "node --test tests/release-baseline-guard.test.mjs tests/responsive-mobile-batch1.test.mjs",
    "benchmark:style-progress": "tsx scripts/benchmark-style-progress.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:team-access": "tsx --test --test-concurrency=1 features/permissions/server/__tests__/team-access-client.test.ts server/integration/team-access.integration.test.ts",
    "test:team-access-ui": "tsx --test --test-concurrency=1 server/integration/team-access-ui.integration.test.mjs",
    "source:ainuoke": "tsx server/ainuoke-source/cli.ts",
    "test:ainuoke-server-source": "tsx --test --test-concurrency=1 server/integration/ainuoke-server-source.test.ts server/integration/ainuoke-server-source.integration.test.ts",
    "test:ainuoke-continuous": "tsx --test --test-concurrency=1 server/integration/ainuoke-continuous.test.ts server/integration/ainuoke-selected-binding.test.ts server/integration/ainuoke-selected-binding.integration.test.ts server/integration/ainuoke-binding.integration.test.ts server/integration/ainuoke-binding-cli.integration.test.ts server/integration/ainuoke-additions.test.ts server/integration/ainuoke-additions.integration.test.ts server/integration/order-read-capability.test.ts server/integration/order-alerts.integration.test.ts server/integration/material-confirmations.integration.test.ts",
    "test:ainuoke-continuous-ui": "tsx --test server/integration/ainuoke-continuous-ui.integration.test.mjs",
    "demo:ainuoke-continuous": "tsx scripts/demo-ainuoke-continuous.ts",
    "test:animated-login-ui": "tsx --test --test-concurrency=1 server/integration/animated-login-ui.integration.test.mjs",
    "demo:login": "tsx scripts/demo-login.ts",
    "source:ainuoke:readiness": "tsx server/ainuoke-source/readiness.ts",
    "test:ainuoke-readiness": "tsx --test --test-concurrency=1 server/integration/ainuoke-readiness.test.ts server/integration/ainuoke-readiness.integration.test.ts",
    "test:ainuoke-readonly-audit": "tsx --test server/integration/ainuoke-readonly-audit.test.ts",
    "test:ainuoke-targeted-diagnostic": "tsx --test server/integration/ainuoke-targeted-diagnostic.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
