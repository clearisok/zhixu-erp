{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:local": "vinext dev --hostname 127.0.0.1 --port 3001",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node dist/server/server/index.js",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:status": "tsx server/db/migration-status.ts",
    "test:bootstrap-source": "tsx --test --test-concurrency=1 server/integration/bootstrap-source.test.ts",
    "test:bootstrap-runner": "tsx --test --test-concurrency=1 server/integration/bootstrap-source.test.ts server/integration/bootstrap-runner.integration.test.ts",
    "test:rbac-activation": "tsx --test --test-concurrency=1 server/integration/rbac-activation.integration.test.ts",
    "test:server-auth-frontend": "tsx --test features/server-auth/__tests__/*.test.ts features/quote-center/server/__tests__/*.test.ts",
    "test:server-auth-integration": "tsx --test --test-concurrency=1 server/integration/browser-session-e2e.integration.test.ts",
    "test:shadow-read": "node --test tests/sales-order-server-shadow-read.test.mjs",
    "test:database-ops": "node --test scripts/__tests__/database-ops-safety.test.mjs && tsx --test server/db/migration-evidence.test.ts",
    "preview:quote-master-settings": "tsx scripts/preview-quote-master-settings-backup.ts",
    "rehearse:quote-master-settings": "tsx scripts/rehearse-quote-master-settings.ts",
    "test:confirmed-commercial-terms": "tsx --test --test-concurrency=1 features/confirmed-commercial-terms/__tests__/client.test.ts server/integration/confirmed-commercial-terms.integration.test.ts && node --test tests/confirmed-commercial-terms-ui.test.mjs",
    "test:postgres": "tsx --test --test-concurrency=1 server/integration/postgres.integration.test.ts server/integration/migration-activation.integration.test.ts server/integration/confirmed-commercial-terms.integration.test.ts server/integration/bootstrap-runner.integration.test.ts server/integration/rbac-activation.integration.test.ts server/integration/browser-session-e2e.integration.test.ts server/integration/quote-foundation.integration.test.ts server/integration/quote-api.integration.test.ts server/integration/quote-numbering.integration.test.ts server/integration/quote-master-settings.integration.test.ts server/integration/quote-master-settings-migration.integration.test.ts server/integration/local-single-user.integration.test.ts server/integration/quote-attachments.integration.test.ts server/integration/s3-storage.integration.test.ts",
    "test:attachment-s3": "tsx --test --test-concurrency=1 server/integration/s3-storage.integration.test.ts",
    "qa:data:prepare": "node scripts/generate-ui-qa-data.mjs prepare",
    "qa:data:cleanup": "node scripts/generate-ui-qa-data.mjs cleanup",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test tests/*.test.mjs",
    "benchmark:style-progress": "tsx scripts/benchmark-style-progress.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
