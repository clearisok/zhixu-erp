{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": false,
    "isolatedModules": false,
    "noEmit": false,
    "incremental": false,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "../dist/server"
  },
  "include": ["./**/*.ts"],
  "exclude": ["./integration/**/*.ts"]
}
