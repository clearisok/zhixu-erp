# Copy to .env and provide values locally. Never commit the populated .env.
ZHIXU_DB_NAME=zhixu
ZHIXU_DB_USER=zhixu
ZHIXU_DB_PASSWORD=
ZHIXU_ADMIN_USERNAME=admin
ZHIXU_ADMIN_DISPLAY_NAME=系统管理员
ZHIXU_ADMIN_PASSWORD=

# Legacy production UI remains on 3000. The Phase 1 Node server profile uses 3002.
ZHIXU_BIND_ADDRESS=127.0.0.1
ZHIXU_PORT=3000
ZHIXU_SERVER_BIND_ADDRESS=127.0.0.1
ZHIXU_SERVER_PUBLIC_PORT=3002
ZHIXU_SERVER_ORIGIN=http://127.0.0.1:3002

# Standalone API development process (proxied by Vite at 127.0.0.1:3001).
ZHIXU_SERVER_HOST=127.0.0.1
ZHIXU_SERVER_PORT=3100
ZHIXU_ALLOWED_ORIGINS=http://127.0.0.1:3001
ZHIXU_COOKIE_SECURE=false
